{
  "name": "kripke-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "gen:types": "json2ts --input ../schemas/kripke.schema.json --output src/types/kripke.ts --additionalProperties false --bannerComment \"/* eslint-disable */\n/**\n * Generated from schemas/kripke.schema.json -- do not edit by hand.\n * Run \\`npm run gen:types\\` after changing the schema.\n */\"",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@types/cytoscape": "^3.21.9",
    "@types/cytoscape-edgehandles": "^4.0.5",
    "@types/dagre": "^0.7.54",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "json-schema-to-typescript": "^16.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "cytoscape": "^3.34.2",
    "cytoscape-dagre": "^4.0.1",
    "cytoscape-edgehandles": "^4.0.1",
    "dagre": "^0.8.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
