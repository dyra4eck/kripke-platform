{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dyra4eck/kripke-platform/schemas/kripke.schema.json",
  "title": "Kripke model",
  "type": "object",
  "required": ["states", "initial_states", "transitions", "state_predicates"],
  "additionalProperties": false,
  "properties": {
    "states": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/identifier" }
    },
    "initial_states": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/identifier" }
    },
    "transitions": {
      "type": "array",
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": { "$ref": "#/$defs/identifier" }
      }
    },
    "state_predicates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["state", "predicates"],
        "additionalProperties": false,
        "properties": {
          "state": { "$ref": "#/$defs/identifier" },
          "predicates": {
            "type": "array",
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/identifier" }
          },
          "comment": { "type": "string" }
        }
      }
    },
    "specifications": {
      "type": "array",
      "items": { "$ref": "#/$defs/temporal_formula" }
    },
    "fairness": {
      "type": "array",
      "items": { "$ref": "#/$defs/temporal_formula" }
    },
    "metadata": { "type": "object" }
  },
  "$defs": {
    "identifier": {
      "description": "SMV identifier: letter or underscore, then letters/digits/underscore/$/#/-",
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z_][A-Za-z0-9_$#-]*$"
    },
    "temporal_formula": {
      "description": "CTL/LTL formula. Deliberately restricted charset: no semicolons, braces or comment markers, so the formula cannot escape into the SMV grammar.",
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^[A-Za-z0-9_$#\\s()!&|<>=\\[\\]\\.,+*/-]+$"
    }
  }
}
